# --- Credentials -------------------------------------------------------------
# Inference: bearer token for the OpenAI-compatible Token Factory endpoint.
NEBIUS_API_KEY=

# Sandboxes: the Contree SDK's IAMAuth reads NEBIUS_API_KEY for the bearer token
# and NEBIUS_PROJECT_ID for the mandatory `Project` header. Sandbox access is
# granted per project, not per key, so a working inference key tells you nothing
# about whether sandboxes are enabled. spike_sandbox.py probes them separately.
NEBIUS_PROJECT_ID=

# Optional. Some accounts issue a separate token for Sandboxes. Leave blank to
# reuse NEBIUS_API_KEY, which is the common case.
CONTREE_TOKEN=

# Account identifiers, for reference when requesting sandbox access.
# These are NOT the project id and cannot be used in its place.
NEBIUS_USER_ID=tenantuseraccount-e00qt6wfbfqn2fbmc2
NEBIUS_TENANT_ID=aitenant-e00x1hmm3z4wndrbnb

# Draft PRs. Fine-grained token, scoped to a FORK you own, with exactly
# contents:write and pull_requests:write. Never scope it to the upstream repo.
GITHUB_TOKEN=
# owner/name of the fork Principal pushes branches to. Leave blank to disable
# publishing entirely; the job still runs and still produces a verification report.
PRINCIPAL_FORK_REPO=

# --- Endpoints and models ----------------------------------------------------
PRINCIPAL_INFERENCE_BASE=https://api.tokenfactory.nebius.com/v1/
PRINCIPAL_SANDBOX_BASE=https://api.tokenfactory.nebius.com/sandboxes/
# The baseline is pinned by tag by default, which is a moving target — see the
# supply-chain risk in docs/THREAT_MODEL.md. Pin by digest instead when it
# matters more than staying current with Python patch releases, e.g.
# PRINCIPAL_BASE_IMAGE=python@sha256:<digest>
PRINCIPAL_BASE_IMAGE=python:3.11-slim
PRINCIPAL_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
PRINCIPAL_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
PRINCIPAL_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# Which tier plans. The design document's open question: Super is documented for
# long-horizon planning at a fifth of Ultra's active parameters. Measure, do not assume.
PRINCIPAL_PLANNER_TIER=ultra

# --- Tunables ----------------------------------------------------------------
MAX_PARALLEL_TASKS=8
MAX_INFLIGHT_OPS=24
CANDIDATES_PER_TASK=3
MAX_REPAIRS=2
RADIUS_MAX_DEPTH=3
RADIUS_FILE_CAP=40
MAX_TASKS=12
TASK_TIMEOUT_S=300
SANDBOX_TIMEOUT_S=600
TOKEN_BUDGET_DEFAULT=2000000
# Fail closed if more than this fraction of planned tasks was discarded.
MAX_DISCARD_RATIO=0.30

# --- Demo flags --------------------------------------------------------------
# Serve a recorded run from runs/ instead of executing. This is the backup plan
# as a switch: the same dashboard renders live and replayed runs.
PRINCIPAL_REPLAY=
# Delay event emission by N ms so the dashboard is legible on video.
PRINCIPAL_SLOW_MO_MS=0
# Skip the boot-time capability probe and pin one protocol: schema | tools | text
PRINCIPAL_FORCE_PROTOCOL=
# Disk cache for model responses. Makes a re-score free after a scoring bug.
PRINCIPAL_MODEL_CACHE=1
